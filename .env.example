# Copia questo file in ".env" e inserisci le tue chiavi reali.
# Il file ".env" NON va mai caricato su GitHub o condiviso.

# Chiave API di Anthropic (console.anthropic.com) - obbligatoria
ANTHROPIC_API_KEY=

# Modello da usare per generare le risposte di Vox
ANTHROPIC_MODEL=claude-sonnet-5

# Facoltativa: chiave per un servizio di generazione immagini a tua scelta.
# Se lasciata vuota, l'app funziona comunque ma mostrera' un placeholder
# al posto delle immagini generate da Vox.
IMAGE_API_KEY=

# Porta locale del server (facoltativa)
PORT=3000
